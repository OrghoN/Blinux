#!/usr/bin/env bash
# blinux-console-speech: turn espeakup console speech on or off.
#
# Usage:
#   blinux-console-speech enable|disable|status [--root DIR] [--no-systemctl]
#
# By default Blinux matches the author's machine: espeakup is off, and Orca
# speaks once GDM is up. "enable" makes espeakup speak on the text consoles too,
# routed through the logged-in user's PulseAudio so it doesn't fight PulseAudio
# for the sound card:
#   1. /etc/pulse/default.pa.d/10-blinux-espeakup.pa opens a shared socket
#   2. /etc/systemd/system/espeakup.service.d/10-blinux-pulse.conf points
#      espeakup at that socket
#   3. espeakup.service is enabled
# With nobody logged in, the socket doesn't exist and espeak-ng falls back to ALSA.
#
# --root DIR      operate on a system mounted at DIR (the installer uses /mnt)
# --no-systemctl  only write files (used by tests)
set -euo pipefail

here="$(cd "$(dirname "$(readlink -f "${BASH_SOURCE[0]}")")" && pwd)"
if [[ -f "$here/../lib/common.sh" ]]; then
    # shellcheck source=tools/lib/common.sh
    source "$here/../lib/common.sh"
else
    # shellcheck source=tools/lib/common.sh
    source /usr/lib/blinux/common.sh
fi

PULSE_DROPIN=/etc/pulse/default.pa.d/10-blinux-espeakup.pa
UNIT_DROPIN=/etc/systemd/system/espeakup.service.d/10-blinux-pulse.conf
USE_SYSTEMCTL=1
cmd=""

while (($#)); do
    case "$1" in
        enable | disable | status) cmd="$1"; shift ;;
        --root) ROOT="$2"; shift 2 ;;
        --no-systemctl) USE_SYSTEMCTL=0; shift ;;
        -h | --help) sed -n '2,/^set -euo/p' "$0" | sed '$d; s/^# \{0,1\}//'; exit 0 ;;
        *) die "unknown argument: $1 (try --help)" ;;
    esac
done
[[ -n "$cmd" ]] || die "say enable, disable or status (try --help)"

# Templates ship in blinux-config, inside the target root.
share="${BLINUX_SHARE:-$(rootpath /usr/share/blinux)}"

systemctl_() {
    ((USE_SYSTEMCTL)) || return 0
    if [[ "$ROOT" == / ]]; then
        run systemctl "$@"
    else
        run systemctl --root="$ROOT" "$@"
    fi
}

enable_speech() {
    write_file "$PULSE_DROPIN" <"$share/console-speech/pulse-espeakup.pa"
    write_file "$UNIT_DROPIN" <"$share/console-speech/espeakup-pulse.conf"
    if [[ "$ROOT" == / ]]; then
        systemctl_ daemon-reload
        systemctl_ enable --now espeakup.service
    else
        systemctl_ enable espeakup.service
    fi
    say "Console speech is on."
    say "Log out and back in once, so PulseAudio opens the shared speech socket."
}

disable_speech() {
    if [[ "$ROOT" == / ]]; then
        systemctl_ disable --now espeakup.service
    else
        systemctl_ disable espeakup.service
    fi
    remove_file "$PULSE_DROPIN"
    remove_file "$UNIT_DROPIN"
    [[ "$ROOT" == / ]] && systemctl_ daemon-reload
    say "Console speech is off. Orca still speaks in the desktop."
}

status_speech() {
    if [[ -f "$(rootpath "$UNIT_DROPIN")" && -f "$(rootpath "$PULSE_DROPIN")" ]]; then
        say "Console speech is on."
    else
        say "Console speech is off."
    fi
}

case "$cmd" in
    enable) enable_speech ;;
    disable) disable_speech ;;
    status) status_speech ;;
esac

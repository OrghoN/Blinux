#!/usr/bin/env bash
# blinux-dotfiles: clone a dotfiles repository and set it up for a user.
#
# Usage:
#   blinux-dotfiles [--url URL] [--user NAME] [--root DIR] [--dir PATH]
#
#   --url   repository to clone (default https://github.com/OrghoN/.dotfiles)
#   --user  whose dotfiles (default: the user running sudo, or yourself)
#   --root  set up a system mounted at DIR (the installer uses /mnt)
#   --dir   where to clone, relative to the user's home (default .dotfiles)
#
# Everything runs as the user, never as root. After cloning:
#   1. If the repository has an executable bootstrap script (blinux-bootstrap,
#      bootstrap.sh, install.sh or setup.sh), run it, with $dotfiles set to the
#      clone, and stop there.
#   2. Otherwise link files the way the OrghoN/.dotfiles README describes:
#        top-level dotfiles (.zshrc, .p10k.zsh, ...)  -> ~/
#        init.el                                     -> ~/.emacs.d/init.el
#        *.zsh and custom/*.zsh                      -> ~/.oh-my-zsh/custom/
#      Existing files are moved aside as NAME.blinux-backup first.
#      ~/.oh-my-zsh is copied from the system oh-my-zsh package and the
#      powerlevel10k theme is linked into it, since such dotfiles expect both.
#      "export dotfiles=..." is added to ~/.zshenv.
set -euo pipefail

here="$(cd "$(dirname "$(readlink -f "${BASH_SOURCE[0]}")")" && pwd)"
if [[ -f "$here/../lib/common.sh" ]]; then
    # shellcheck source=tools/lib/common.sh
    source "$here/../lib/common.sh"
else
    # shellcheck source=tools/lib/common.sh
    source /usr/lib/blinux/common.sh
fi

URL="https://github.com/OrghoN/.dotfiles"
TARGET_USER="${SUDO_USER:-$(id -un)}"
DIR=".dotfiles"
AS_USER=0
OMZ_SYSTEM="${OMZ_SYSTEM:-/usr/share/oh-my-zsh}"
P10K_SYSTEM="${P10K_SYSTEM:-/usr/share/zsh-theme-powerlevel10k}"

while (($#)); do
    case "$1" in
        --url) URL="$2"; shift 2 ;;
        --user) TARGET_USER="$2"; shift 2 ;;
        --root) ROOT="$2"; shift 2 ;;
        --dir) DIR="$2"; shift 2 ;;
        --as-user) AS_USER=1; shift ;; # internal: already running as the user
        -h | --help) sed -n '2,/^set -euo/p' "$0" | sed '$d; s/^# \{0,1\}//'; exit 0 ;;
        *) die "unknown argument: $1 (try --help)" ;;
    esac
done

# ---------------------------------------------------------------- as the user

backup_and_link() {
    local src="$1" dest="$2"
    mkdir -p "$(dirname "$dest")"
    if [[ -L "$dest" && "$(readlink "$dest")" == "$src" ]]; then
        return 0
    fi
    if [[ -e "$dest" || -L "$dest" ]]; then
        mv "$dest" "$dest.blinux-backup"
        say "Moved your old $(basename "$dest") to $(basename "$dest").blinux-backup."
    fi
    ln -s "$src" "$dest"
}

setup_oh_my_zsh() {
    local omz="$HOME/.oh-my-zsh"
    if [[ ! -d "$omz" && -d "$OMZ_SYSTEM" ]]; then
        cp -r "$OMZ_SYSTEM" "$omz"
        say "Set up oh-my-zsh in ~/.oh-my-zsh."
    fi
    if [[ -d "$P10K_SYSTEM" && -d "$omz" && ! -e "$omz/custom/themes/powerlevel10k" ]]; then
        mkdir -p "$omz/custom/themes"
        ln -s "$P10K_SYSTEM" "$omz/custom/themes/powerlevel10k"
    fi
}

link_dotfiles() {
    local repo="$1" f name custom="$HOME/.oh-my-zsh/custom"
    shopt -s nullglob dotglob
    for f in "$repo"/.*; do
        name="$(basename "$f")"
        case "$name" in
            . | .. | .git | .github | .gitignore | .gitmodules) continue ;;
        esac
        [[ -f "$f" || -d "$f" ]] || continue
        backup_and_link "$f" "$HOME/$name"
    done
    shopt -u dotglob
    if [[ -f "$repo/init.el" ]]; then
        backup_and_link "$repo/init.el" "$HOME/.emacs.d/init.el"
    fi
    for f in "$repo"/*.zsh "$repo"/custom/*.zsh; do
        backup_and_link "$f" "$custom/$(basename "$f")"
    done
    shopt -u nullglob
    if ! grep -qs '^export dotfiles=' "$HOME/.zshenv"; then
        printf 'export dotfiles=%q\n' "$repo" >>"$HOME/.zshenv"
    fi
    say "Linked the dotfiles into your home directory."
}

as_user_main() {
    local repo="$HOME/$DIR" script
    if [[ -d "$repo/.git" ]]; then
        say "Updating the dotfiles in ~/$DIR."
        git -C "$repo" pull --ff-only --quiet
    else
        say "Cloning $URL into ~/$DIR."
        git clone --quiet "$URL" "$repo"
    fi
    for script in blinux-bootstrap bootstrap.sh install.sh setup.sh; do
        if [[ -x "$repo/$script" ]]; then
            say "Running the repository's own $script."
            (cd "$repo" && dotfiles="$repo" "./$script")
            return 0
        fi
    done
    setup_oh_my_zsh
    link_dotfiles "$repo"
}

if ((AS_USER)); then
    as_user_main
    exit 0
fi

# ---------------------------------------------------------------- dispatch

[[ "$TARGET_USER" != root ]] || die "Dotfiles are set up for a normal user, not root. Use --user NAME."
self_args=(--as-user --url "$URL" --dir "$DIR")

if [[ "$ROOT" != / ]]; then
    run arch-chroot "$ROOT" runuser -l "$TARGET_USER" -c "blinux-dotfiles $(printf '%q ' "${self_args[@]}")"
elif [[ "$(id -un)" == "$TARGET_USER" ]]; then
    run "$0" "${self_args[@]}"
elif [[ $EUID -eq 0 ]]; then
    run runuser -l "$TARGET_USER" -c "$(printf '%q ' "$0" "${self_args[@]}")"
else
    die "Run this as $TARGET_USER, or with sudo."
fi
